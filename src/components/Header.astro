---
import { GITHUB_URL, SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import ThemeToggle from './ThemeToggle.astro';
---

<header class="fixed inset-x-0 top-3 z-50 flex justify-center px-3 sm:top-5">
	<nav class="glass-strong flex max-w-full items-center gap-0.5 px-2.5 py-1.5 sm:gap-1 sm:px-3">
		<a href="/" class="mr-1 flex items-center gap-2 whitespace-nowrap pl-1 text-sm font-bold tracking-wide">
			<img src="/images/logo/logo.svg" alt="" class="h-6 w-6 rounded-full" />
			<span class="hidden sm:inline">{SITE_TITLE}</span>
		</a>
		<HeaderLink href="/">首页</HeaderLink>
		<HeaderLink href="/archive">归档</HeaderLink>
		<HeaderLink href="/friends">友链</HeaderLink>
		<HeaderLink href="/about">关于</HeaderLink>
		<ThemeToggle />
		<a
			href={GITHUB_URL}
			target="_blank"
			rel="noopener noreferrer"
			class="flex h-9 w-9 items-center justify-center rounded-full transition-colors hover:bg-white/20 dark:hover:bg-white/10"
		>
			<span class="sr-only">GitHub</span>
			<svg viewBox="0 0 16 16" aria-hidden="true" class="h-5 w-5"
				><path
					fill="currentColor"
					d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
				></path></svg
			>
		</a>
	</nav>
</header>
