---
import { AUTHOR, GITHUB_URL } from '../consts';

const today = new Date();
---

<footer class="border-t py-8" style="border-color: var(--card-border);">
	<div class="mono mx-auto flex max-w-220 flex-wrap items-center justify-center gap-x-2 gap-y-1 px-6 text-[12.5px] text-muted">
		<span>&copy; {today.getFullYear()} {AUTHOR}</span>
		<span class="opacity-40">·</span>
		<a href={GITHUB_URL} target="_blank" rel="noopener noreferrer" class="hover:underline">GitHub</a>
		<span class="opacity-40">·</span>
		<a href="/rss.xml" class="hover:underline">RSS</a>
		<span class="opacity-40">·</span>
		<span>built with <a href="https://astro.build/" target="_blank" rel="noopener noreferrer" class="hover:underline">Astro</a></span>
	</div>
</footer>
