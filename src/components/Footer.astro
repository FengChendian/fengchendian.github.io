---
import { AUTHOR, GITHUB_URL, SITE_TITLE } from '../consts';

const today = new Date();
---

<footer class="flex justify-center px-3 pb-6">
	<div class="glass flex flex-wrap items-center justify-center gap-x-4 gap-y-1 px-6 py-3 text-sm text-muted">
		<span>&copy; {today.getFullYear()} {AUTHOR} · {SITE_TITLE}</span>
		<a href={GITHUB_URL} target="_blank" rel="noopener noreferrer" class="accent hover:underline">GitHub</a>
		<a href="/rss.xml" class="accent hover:underline">RSS</a>
		<span>Powered by <a href="https://astro.build/" target="_blank" rel="noopener noreferrer" class="accent hover:underline">Astro</a></span>
	</div>
</footer>
