---
import { getCollection, render } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { HOME_POST_COUNT, SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = await Promise.all(
	(await getCollection('blog'))
		.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
		.map(async (post) => ({
			...post,
			minutesRead: (await render(post)).remarkPluginFrontmatter.minutesRead as number,
		})),
);
const latestPosts = posts.slice(0, HOME_POST_COUNT);
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<section class="py-10">
		<span class="hero-tag mb-6">物理 · 存内计算 · AI Infra</span>
		<h1 class="text-[clamp(34px,6vw,54px)] leading-[1.15] font-extrabold tracking-[-1px]">
			<span class="grad">Yichen Zhao</span><br />
			<!-- 在物理与代码的边界探索<span class="cursor-blink"></span> -->
		</h1>
		<p class="text-muted mt-5 max-w-140 text-[17px]">
			一些有关物理、存内计算和代码的笔记
		</p>
	</section>

	<h2 class="section-title mb-6">latest posts</h2>
	<div class="flex flex-col gap-4">
		{
			latestPosts.map((post) => (
				<a href={`/blog/${post.id}/`} class="card card-hover block px-6 py-6 no-underline">
					<h3 class="mb-1.5 text-xl font-bold" style="color: var(--text)">
						{post.data.title}
					</h3>
					<div class="mono text-muted mb-2.5 text-xs">
						<FormattedDate date={post.data.pubDate} />
						<span class="mx-2 opacity-50">·</span>
						<span>{post.minutesRead} min read</span>
					</div>
					<p class="text-muted line-clamp-2 text-[14.5px]">{post.data.description}</p>
					{post.data.tags.length > 0 && (
						<div class="mt-3.5 flex flex-wrap gap-2">
							{post.data.tags.map((tag) => (
								<span class="tag-pill">#{tag}</span>
							))}
						</div>
					)}
				</a>
			))
		}
	</div>

	{
		posts.length > HOME_POST_COUNT && (
			<div class="mt-8 flex justify-center">
				<a href="/archive/" class="btn-accent mono">
					<span class="btn-accent-text">
						<span class="btn-accent-label">全部文章</span>
						<span class="btn-accent-label btn-accent-label--hover" aria-hidden="true">点击跳转</span>
					</span>
				</a>
			</div>
		)
	}
</BaseLayout>
