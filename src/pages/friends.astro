---
import BaseLayout from '../layouts/BaseLayout.astro';

const friends = [
	{
		name: 'Jinbin Bai',
		desc: '个人主页',
		url: 'https://noyii.github.io/',
		avatar: '/images/friends/jinbin.jpg',
	},
];
---

<BaseLayout title="友链 - Yichen's Homepage" description="友情链接">
	<h1 class="mb-8 text-3xl font-bold">友链</h1>
	<ul class="grid gap-5 sm:grid-cols-2">
		{
			friends.map((friend) => (
				<li>
					<a href={friend.url} target="_blank" rel="noopener noreferrer" class="glass glass-hover flex items-center gap-4 p-5 no-underline">
						<img src={friend.avatar} alt={friend.name} class="h-14 w-14 rounded-full object-cover" loading="lazy" />
						<div>
							<h2 class="text-base font-bold" style="color: var(--text)">
								{friend.name}
							</h2>
							<p class="text-muted text-sm">{friend.desc}</p>
						</div>
					</a>
				</li>
			))
		}
	</ul>
</BaseLayout>
