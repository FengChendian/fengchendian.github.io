---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 - Yichen's Homepage" description="页面不存在">
	<div class="card mt-10 px-8 py-16 text-center">
		<p class="mono grad mb-2 text-6xl font-bold">404</p>
		<h1 class="mb-4 text-2xl font-bold">页面不存在</h1>
		<p class="text-muted mono mb-8 text-sm">$ cd /nowhere&nbsp;&nbsp;# no such file or directory</p>
		<a href="/" class="tag-pill inline-block px-5 py-2 text-[13px] no-underline">cd ~/ （返回首页）</a>
	</div>
</BaseLayout>
