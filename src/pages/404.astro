---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 - Yichen's Homepage" description="页面不存在">
	<div class="glass px-8 py-16 text-center">
		<p class="mb-2 text-6xl font-bold accent">404</p>
		<h1 class="mb-4 text-2xl font-bold">页面不存在</h1>
		<p class="text-muted mb-8">你要找的页面可能已被移动或删除。</p>
		<a href="/" class="glass-strong inline-block px-6 py-2.5 text-sm font-medium no-underline" style="color: var(--text)">
			返回首页
		</a>
	</div>
</BaseLayout>
