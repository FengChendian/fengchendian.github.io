---
import type { MarkdownHeading } from 'astro';
import type { ImageMetadata } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import FormattedDate from '../components/FormattedDate.astro';
import TocFloat from '../components/TocFloat.astro';
import BaseLayout from './BaseLayout.astro';

type Props = CollectionEntry<'blog'>['data'] & { headings?: MarkdownHeading[] };

const { title, description, pubDate, updatedDate, heroImage, tags, headings = [] } = Astro.props;

// heroImage 是相对于 src/assets/ 的文件名，在构建时解析为打包后的图片
const images = import.meta.glob<{ default: ImageMetadata }>('../assets/**/*.{png,jpg,jpeg,webp,gif}', {
	eager: true,
});
const heroImageSrc = heroImage
	? Object.entries(images).find(([path]) => path.endsWith(`/${heroImage}`))?.[1].default
	: undefined;
---

<BaseLayout title={`${title} - Yichen's Homepage`} description={description} image={heroImageSrc?.src}>
	<article class="mx-auto max-w-190 pt-10 pb-16" data-pagefind-body>
		<a href="/archive" class="mono mb-9 inline-block text-[13px] no-underline">cd ../archive</a>
		<header class="mb-10">
			<h1 class="text-[34px] leading-tight font-extrabold tracking-[-0.5px]">{title}</h1>
			<div
				class="mono text-muted mt-3.5 flex flex-wrap items-center gap-x-4 gap-y-2 border-b pb-6 text-[13px]"
				style="border-color: var(--card-border);"
			>
				<FormattedDate date={pubDate} />
				{
					updatedDate && (
						<span class="italic">
							更新于 <FormattedDate date={updatedDate} />
						</span>
					)
				}
				{
					tags.length > 0 && (
						<span class="flex flex-wrap gap-2">
							{tags.map((tag) => (
								<span class="tag-pill">#{tag}</span>
							))}
						</span>
					)
				}
			</div>
		</header>
		{
			heroImageSrc && (
				<Image src={heroImageSrc} alt="" class="mb-8 h-auto max-h-72 w-auto rounded-[10px]" />
			)
		}
		<div class="prose dark:prose-invert max-w-none prose-pre:bg-transparent prose-pre:p-0">
			<slot />
		</div>
	</article>
	<TocFloat headings={headings} />
</BaseLayout>
